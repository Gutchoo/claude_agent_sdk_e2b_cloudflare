# Anthropic API Key
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# E2B API Key
# Get your key at: https://e2b.dev/dashboard -> Keys tab
E2B_API_KEY=e2b_your_api_key_here

# Optional: E2B Template (defaults to "base")
# E2B_TEMPLATE=base

# Optional: Sandbox timeout in seconds (defaults to 300 = 5 minutes)
# E2B_SANDBOX_TIMEOUT=300
